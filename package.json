{
    "name": "macbid-ical",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pkmnct/macbid-ical.git"
    },
    "author": "George W. Walker",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/pkmnct/macbid-ical/issues"
    },
    "engines": {
        "node": "22 || >=24"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "ical-generator": "^11.0.0",
        "macbid-ts-api": "^1.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.5.0",
        "eslint-plugin-promise": "^7.3.0",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "scripts": {
        "build": "tsc",
        "dev": "ts-node --esm index.ts",
        "lint": "eslint .",
        "start": "node index.js",
        "predocker": "npm run build",
        "docker:build": "npm run build && docker build -t pkmnct/macbid-ical:latest .",
        "docker:setup": "docker buildx inspect macbid-multiarch >/dev/null 2>&1 || docker buildx create --name macbid-multiarch --driver docker-container --bootstrap --use",
        "docker": "npm run docker:setup && docker buildx build --builder macbid-multiarch --platform linux/amd64,linux/arm64 -t pkmnct/macbid-ical:latest --push ."
    },
    "main": "index.js",
    "type": "module"
}